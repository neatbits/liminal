# Tilkobling for `npm run deploy`. Kopier til .env.deploy og fyll inn – .env.deploy lastes
# aldri opp til git. Detaljene finner du i one.com sitt kontrollpanel under SFTP/SSH
# (der setter du også passordet). For flere nettsteder: lag f.eks. .env.deploy.neatbits og
# kjør `npm run deploy -- --env .env.deploy.neatbits`.

# Vertsnavn og port for SFTP (sjekk i kontrollpanelet; port 22 er standard for SFTP).
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=

# La passordet stå tomt for å bli spurt hver gang (tryggest), eller bruk en SSH-nøkkel.
DEPLOY_PASSWORD=
# DEPLOY_KEY=C:/Users/deg/.ssh/id_ed25519

# Mappen på serveren som er nettstedets rot (der index.html skal ligge). For neatbits.no
# er det undermappen liminal/.
DEPLOY_DIR=/
